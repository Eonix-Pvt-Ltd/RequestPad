meta {
  name: Token-protected list
  type: http
  seq: 1
}

get {
  url: https://api.example.com/items?page=1&size={{pageSize}}
  body: none
  auth: oauth2
}

params:query {
  page: 1
  size: {{pageSize}}
  ~debug: true
}

headers {
  Accept: application/json
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: https://auth.example.com/oauth/token
  refresh_token_url: 
  client_id: {{clientId}}
  client_secret: {{clientSecret}}
  scope: items:read
  credentials_placement: basic_auth_header
  credentials_id: credentials
  token_source: access_token
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: true
}

settings {
  encodeUrl: true
  followRedirects: false
  timeout: 5000
}

docs {
  Lists items.
  
  Requires the `items:read` scope.
}
