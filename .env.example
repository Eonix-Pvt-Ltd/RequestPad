# RequestPad has no runtime environment variables: the app has no backend and stores secrets in the Keychain.
# These variables are used only by the human-gated upload step (docs/RELEASE_RUNBOOK.md, B11 step 4).
# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# Absolute path to the App Store Connect API private key (.p8). Keep it outside the repository.
ASC_KEY_PATH=/absolute/path/outside/repo/AuthKey_KEYID.p8
# App Store Connect API key ID (10 characters, shown in App Store Connect → Users and Access → Integrations).
ASC_KEY_ID=
# App Store Connect API issuer ID (UUID shown on the same page).
ASC_ISSUER_ID=
